rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // HELPER FUNCTIONS — evaluated server-side, no extra reads needed
    // ================================================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // NOTE: each helper call below costs 1 read — minimise usage
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    // A user is "active" unless their profile explicitly sets isActive == false.
    // (Missing/legacy profile docs without the field are treated as active.)
    // This is what actually revokes access when an admin deactivates an account.
    function isActiveUser() {
      return isAuth() && getUserData().isActive != false;
    }

    function isAdmin() {
      return isActiveUser() && getUserRole() == 'super_admin';
    }

    function isStaff() {
      return isActiveUser() && getUserRole() in ['super_admin', 'faculty', 'lab_assistant'];
    }

    // ================================================================
    // USERS COLLECTION
    // ================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // New users self-create with role='student' only
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'userType', 'isActive', 'createdAt'])
                    && request.resource.data.role == 'student';
      // Users update their own non-sensitive fields; admins update anything
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'email']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ================================================================
    // EQUIPMENT COLLECTION
    // ================================================================
    match /equipment/{equipmentId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ================================================================
    // BOOKINGS COLLECTION  (Form 2A — Tier 1 machines only)
    // ================================================================
    match /bookings/{bookingId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // Auto-confirm model (Spec 2): status must be 'approved' on create.
      // Server-side validation: active user, own booking, valid time window, and the
      // machine must be a confirmed, bookable (Tier 1) machine that is available/reserved.
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['equipmentId', 'machineId', 'date', 'startTime', 'endTime', 'purpose', 'projectId', 'status', 'safetyAgreementAccepted'])
                    && request.resource.data.keys().hasOnly(['equipmentId', 'machineId', 'machineName', 'userId', 'userEmail', 'userName', 'projectId', 'projectTitle', 'date', 'startTime', 'endTime', 'purpose', 'consumables', 'safetyAgreementAccepted', 'status', 'rejectionReason', 'cancelledBy', 'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'approved'
                    && request.resource.data.safetyAgreementAccepted == true
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.startTime is string
                    && request.resource.data.endTime is string
                    && request.resource.data.startTime.matches('[0-9]{2}:[0-9]{2}')
                    && request.resource.data.endTime.matches('[0-9]{2}:[0-9]{2}')
                    && request.resource.data.startTime < request.resource.data.endTime
                    && get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.tier == 'bookable'
                    && get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.confirmed == true
                    && get(/databases/$(database)/documents/equipment/$(request.resource.data.equipmentId)).data.status in ['available', 'reserved'];
      // Users can cancel own bookings (status/cancelledBy only); staff can fully update.
      allow update: if isAuth() && (
        (isActiveUser()
         && resource.data.userId == request.auth.uid
         && request.resource.data.status == 'cancelled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt']))
        || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // TOOL CHECKOUTS COLLECTION  (Form 2B — Tier 2 tools only)
    // ================================================================
    match /toolCheckouts/{checkoutId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // Server-enforced schema: new checkouts must be 'checking_out', not overdue, with
      // valid enums and no extra/injected fields.
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['toolName', 'toolCategory', 'action', 'projectId', 'locationOfUse', 'conditionAtCheckout', 'quantity', 'expectedReturnDate'])
                    && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'userName', 'universityId', 'projectId', 'projectTitle', 'action', 'toolCategory', 'toolName', 'quantity', 'locationOfUse', 'outsideLocation', 'expectedReturnDate', 'expectedReturnTime', 'conditionAtCheckout', 'notes', 'isOverdue', 'createdAt', 'updatedAt'])
                    && request.resource.data.action == 'checking_out'
                    && request.resource.data.toolCategory in ['Power Tools', 'Hand Tools', 'Measurement Tools', 'Safety Equipment', 'Other']
                    && request.resource.data.locationOfUse in ['in_lab', 'taking_outside']
                    && request.resource.data.conditionAtCheckout in ['good', 'fair', 'damaged']
                    && request.resource.data.isOverdue == false
                    && request.resource.data.expectedReturnDate is string
                    && request.resource.data.expectedReturnDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && (request.resource.data.locationOfUse == 'in_lab'
                        || (request.resource.data.outsideLocation is string && request.resource.data.outsideLocation.size() > 0));
      // Owner may only perform a return (and flip overdue flags); staff can update any.
      allow update: if isAuth() && (
        (isActiveUser()
         && resource.data.userId == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['action', 'conditionAtReturn', 'returnedAt', 'notes', 'isOverdue', 'updatedAt']))
        || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // INVENTORY COLLECTION  (admin stock management)
    // ================================================================
    match /inventory/{itemId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // INVENTORY TRANSACTIONS COLLECTION  (admin stock movements only)
    // ================================================================
    match /inventoryTransactions/{txId} {
      allow read: if isAuth();
      // Only staff create transactions (restock/adjustment/damage) — NOT users doing checkouts
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ================================================================
    // MAINTENANCE COLLECTION
    // ================================================================
    match /maintenance/{recordId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // WORKSHOPS COLLECTION
    // ================================================================
    match /workshops/{workshopId} {
      allow read: if isAuth();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // WORKSHOP REGISTRATIONS COLLECTION
    // ================================================================
    match /workshopRegistrations/{regId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ================================================================
    // PROJECTS COLLECTION  (Form 1 — Project Registration)
    // ================================================================
    match /projects/{projectId} {
      // Projects are only visible to their owner and staff — NOT all authenticated users.
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // Users self-register projects; status must start as 'pending'
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.safetyAgreementAccepted == true
                    && request.resource.data.termsAccepted == true;
      // Users edit own pending/active projects (not status); admins change anything
      allow update: if isAuth() && (
        (isActiveUser() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ================================================================
    // NOTIFICATIONS COLLECTION
    // ================================================================
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // In-app notifications created by staff/admin only (Phase 9 email deferred)
      allow create: if isStaff();
      // Users mark their own as read (isRead field only)
      allow update: if isAuth() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // ================================================================
    // ANNOUNCEMENTS COLLECTION
    // ================================================================
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isStaff();
    }

    // ================================================================
    // ISSUES COLLECTION  (Form 4 — Report an Issue / Suggestion)
    // ================================================================
    match /issues/{issueId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isStaff());
      // New issues start 'open' with valid enums and no injected resolution/status fields.
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.type in ['machine_malfunction', 'safety_concern', 'missing_damaged', 'suggestion', 'other']
                    && request.resource.data.severity in ['low', 'medium', 'high', 'urgent']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 20
                    && request.resource.data.keys().hasOnly(['type', 'severity', 'relatedMachine', 'description', 'dateNoticed', 'userId', 'userName', 'userEmail', 'status', 'createdAt', 'updatedAt']);
      // Staff update status/resolution; users cannot edit after submission
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ================================================================
    // AUDIT LOGS COLLECTION  (append-only, immutable)
    // ================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Audit entries must be written by staff only — no client-side forging.
      allow create: if isStaff();
      allow update, delete: if false; // Immutable
    }

    // ================================================================
    // SETTINGS COLLECTION
    // ================================================================
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ================================================================
    // FEEDBACK COLLECTION (with server-side rate limiting)
    // ================================================================
    match /feedback/{feedbackId} {
      // Only staff/admin can read feedback
      allow read: if isStaff();
      // Authenticated users can create their own feedback — server-enforced schema + rate limiting
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time
        // Exhaustive allowlist — rejects any extra field the client might inject
        && request.resource.data.keys().hasOnly(['userId', 'message', 'createdAt'])
        // Rate limit: at most 1 feedback per user per 5-minute window.
        // The document ID encodes the user + current window, so a second write in the
        // same window fails automatically (create on an existing document is denied).
        // NOTE: the document ID is client-predictable; replace with a Cloud Function
        // or server-enforced flow if stricter rate limiting is required.
        && feedbackId == request.auth.uid + '_' + string(math.floor(request.time.toMillis() / 300000));
      // No one can edit or delete feedback
      allow update, delete: if false;
    }

    // ================================================================
    // DEFAULT DENY
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
