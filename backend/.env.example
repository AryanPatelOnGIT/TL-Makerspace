# Tinker's Lab Backend — Vercel environment variables
# Copy to backend/.env (local) or set in the Vercel project settings.

# Firebase Admin SDK service account. Paste the full JSON on one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ahduni-tinkering-lab","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@ahduni-tinkering-lab.iam.gserviceaccount.com"}

# Comma-separated list of allowed browser origins (no spaces).
# Include your Firebase Hosting domain(s) and local dev server.
CORS_ORIGINS=https://ahduni-tinkering-lab.web.app,https://ahduni-tinkering-lab.firebaseapp.com,http://localhost:5173
