rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ================================================================
    // HELPER — staff role check (reads the Firestore user document)
    // ================================================================
    function isStaff() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['super_admin', 'faculty', 'lab_assistant'];
    }

    // ================================================================
    // EQUIPMENT IMAGES
    // Read: any authenticated user (images shown in the equipment catalog).
    // Write/delete: staff only, restricted to jpeg/png/webp under 5 MB.
    // ================================================================
    match /equipment/{equipmentId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if isStaff()
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isStaff();
    }

    // ================================================================
    // DEFAULT DENY — everything else
    // ================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
